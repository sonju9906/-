import io
import cv2
import numpy as np
import tensorflow as tf
import mediapipe as mp
from fastapi import FastAPI, Request, Response, status, Depends, HTTPException
from fastapi.responses import HTMLResponse, JSONResponse
from typing import List

app = FastAPI()

# (인증 의존성 함수 예시)
async def get_current_user(request: Request):
    token = request.headers.get("Authorization")
    if not token:
        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="Unauthorized")
    return {"user_id": 1}

@app.get("/api/history")
async def get_history(user: dict = Depends(get_current_user)):
    return [
        {
            "id": 1,
            "face_shape": "계란형",
            "recommended_styles": ["시스루 댄디컷", "아이비리그컷"],
            "created_at": "2026-09-23T18:30:00"
        }
    ]

@app.get("/api/bookmarks")
async def get_bookmarks(user: dict = Depends(get_current_user)):
    return [
        {
            "id": 3,
            "style_name": "시스루 댄디컷",
            "face_shape": "계란형",
            "created_at": "2026-09-23T18:35:00"
        }
    ]

@app.delete("/api/bookmarks/{bookmark_id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_bookmark(bookmark_id: int, user: dict = Depends(get_current_user)):
    # DB에서 삭제 로직 수행 후 본문 없이 204 반환
    return Response(status_code=status.HTTP_204_NO_CONTENT)
    return JSONResponse(content={
        "face_shape": "계란형",
        "recommended_styles": ["시스루 댄디컷", "아이비리그컷"],
        "message": "성공적으로 분석되었습니다."
    })
